# El worker vive dentro de la red de Metrica. Copiar como .env en el servidor.
# Nunca guardar valores reales en Git.

NODE_ENV=production
LOG_LEVEL=info
WORKER_ID=ivmet-worker-metrica-01
WORKER_ENABLED=false
# Producción: true tras validar health y aplicar migraciones.
# El daemon de producción exige este filtro vacío. Solo consume alcances de RimMET.
WORKER_SCOPE_ID=
WORKER_OUTBOX_BATCH_SIZE=50
WORKER_OUTBOX_POLL_SECONDS=10
WORKER_CATALOG_INTERVAL_SECONDS=300
# Refresco de alcances ya sincronizados. Las altas se detectan cada POLL_SECONDS.
WORKER_RETRY_SECONDS=60
WORKER_LEASE_SECONDS=300

# DataMET: este login solo tiene SELECT en las cuatro tablas autorizadas.
DATAMET_DB_HOST=192.168.1.5
DATAMET_DB_PORT=1433
DATAMET_DB_NAME=DataMET
DATAMET_DB_USER=IvMETWorker
DATAMET_DB_PASSWORD=REEMPLAZAR_EN_EL_SERVIDOR
DATAMET_DB_ENCRYPT=false
DATAMET_DB_TRUST_SERVER_CERTIFICATE=true

# Base corporativa autonoma IvMET.
IVMET_DB_HOST=192.168.1.5
IVMET_DB_PORT=1433
IVMET_DB_NAME=IvMET
IVMET_DB_USER=IvMETWorker
IVMET_DB_PASSWORD=REEMPLAZAR_EN_EL_SERVIDOR
IVMET_DB_ENCRYPT=false
IVMET_DB_TRUST_SERVER_CERTIFICATE=true

# Usar la URL del proyecto y la service_role key. Esta clave nunca va en Flutter.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REEMPLAZAR_EN_EL_SERVIDOR
