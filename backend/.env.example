# ---------------------------------------------------------------------------
# IvMET API - variables de entorno
# Copiar a .env y completar. NUNCA commitear .env con credenciales reales.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# --- SQL Server (Metrica) -------------------------------------------------
# El servidor SQL vive detras de la VPN corporativa: para desarrollo local
# hay que estar conectado al tunel WireGuard/OpenVPN antes de levantar la API.
DB_HOST=10.0.0.10
DB_PORT=1433
DB_NAME=IvMET
DB_USER=ivmet_api
DB_PASSWORD=changeme
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

# Cadena usada por Prisma (provider = sqlserver).
DATABASE_URL="sqlserver://10.0.0.10:1433;database=IvMET;user=ivmet_api;password=changeme;encrypt=true;trustServerCertificate=true"

# --- JWT ------------------------------------------------------------------
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=cambiar-por-otro-secreto-largo-y-aleatorio
JWT_REFRESH_EXPIRES_IN=30d

# --- Seguridad ------------------------------------------------------------
BCRYPT_SALT_ROUNDS=12
CORS_ORIGINS=*
LOG_LEVEL=debug
