# ---------------------------------------------------------------------------
# IvMET API - variables de entorno
# Copiar a .env y completar. NUNCA commitear .env con credenciales reales.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
API_PREFIX=/api/ivmet/v1

# Habilita el montaje de todas las rutas. Desplegar inicialmente en false.
IVMET_ENABLED=false

# Mantener en false hasta que las reglas metrologicas oficiales hayan sido
# cargadas, validadas y aprobadas por Metrica.
IVMET_SYNC_ENABLED=false
# Lista separada por comas; debe coincidir exactamente con procedimiento_referencia.
IVMET_APPROVED_PROCEDURES=

# --- SQL Server (Metrica) -------------------------------------------------
# El servidor SQL vive detras de la VPN corporativa: para desarrollo local
# hay que estar conectado al tunel WireGuard/OpenVPN antes de levantar la API.
DB_HOST=10.0.0.10
DB_PORT=1433
DB_NAME=DataMET
DB_USER=ServiceMET
DB_PASSWORD=changeme
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

# Cadena usada por Prisma (provider = sqlserver).
DATABASE_URL="sqlserver://10.0.0.10:1433;database=DataMET;user=ServiceMET;password=changeme;encrypt=true;trustServerCertificate=true"

# --- JWT ------------------------------------------------------------------
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=cambiar-por-otro-secreto-largo-y-aleatorio
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=servicemet-api
JWT_AUDIENCE=ivmet-mobile

# --- Seguridad ------------------------------------------------------------
BCRYPT_SALT_ROUNDS=12
CORS_ORIGINS=*
LOG_LEVEL=debug
