{
  "name": "ivmet",
  "version": "0.1.0",
  "private": true,
  "description": "IvMET - Verificaciones intermedias de instrumentos de pesaje. Monorepo (Flutter app + Node.js API) de Metrica Ltda.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "db:test:admin": "node --test scripts/test-admin-db.mjs",
    "preinstall": "only-allow pnpm",
    "backend:dev": "pnpm --filter @ivmet/backend dev",
    "backend:build": "pnpm --filter @ivmet/backend build",
    "backend:start": "pnpm --filter @ivmet/backend start",
    "backend:lint": "pnpm --filter @ivmet/backend lint",
    "backend:test": "pnpm --filter @ivmet/backend test",
    "contracts:build": "pnpm --filter @ivmet/shared-contracts build",
    "worker:build": "pnpm --filter @ivmet/worker build",
    "worker:health": "pnpm --filter @ivmet/worker health",
    "worker:once": "pnpm --filter @ivmet/worker sync:once",
    "worker:start": "pnpm --filter @ivmet/worker start",
    "worker:test": "pnpm --filter @ivmet/worker test",
    "app:get": "cd app && flutter pub get",
    "app:gen": "cd app && dart run build_runner build --delete-conflicting-outputs",
    "app:run": "cd app && flutter run",
    "app:test": "cd app && flutter test",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "packageManager": "pnpm@11.21.0",
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "only-allow": "^1.2.2",
    "typescript": "5.9.3"
  }
}
