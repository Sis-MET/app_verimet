{
  "name": "ivmet",
  "version": "0.1.0",
  "private": true,
  "description": "IvMET - Verificaciones intermedias de instrumentos de pesaje. Monorepo (Flutter app + Node.js API) de Metrica Ltda.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "db:test:admin": "node --test scripts/test-admin-db.mjs scripts/test-bulk-equipment-db.mjs",
    "db:test:operations": "node --test scripts/test-operations-db.mjs",
    "db:test:mobile": "node --test scripts/test-mobile-db.mjs scripts/test-registered-equipment-db.mjs scripts/test-operator-agenda-db.mjs",
    "db:test:plans": "node --test scripts/test-self-service-db.mjs scripts/test-account-deletion-db.mjs",
    "test:mobile-auth": "node --experimental-vm-modules --test scripts/test-mobile-auth.mjs scripts/test-self-service-auth.mjs",
    "preinstall": "only-allow pnpm",
    "backend:dev": "pnpm --filter @ivmet/backend dev",
    "backend:build": "pnpm --filter @ivmet/backend build",
    "backend:start": "pnpm --filter @ivmet/backend start",
    "backend:lint": "pnpm --filter @ivmet/backend lint",
    "backend:test": "pnpm --filter @ivmet/backend test",
    "contracts:build": "pnpm --filter @ivmet/shared-contracts build",
    "worker:build": "pnpm --filter @ivmet/worker build",
    "worker:health": "pnpm --filter @ivmet/worker health",
    "worker:once": "pnpm --filter @ivmet/worker sync:once",
    "worker:start": "pnpm --filter @ivmet/worker start",
    "worker:test": "pnpm --filter @ivmet/worker test",
    "app:get": "cd app && flutter pub get",
    "app:gen": "cd app && dart run build_runner build --delete-conflicting-outputs",
    "app:run": "cd app && flutter run --dart-define-from-file=config/supabase.local.json",
    "app:apk": "cd app && flutter build apk --release --dart-define-from-file=config/supabase.prod.json",
    "app:aab": "cd app && flutter build appbundle --release --dart-define-from-file=config/supabase.prod.json",
    "app:test": "cd app && flutter test",
    "app:goldens": "cd app && flutter test --update-goldens",
    "web:eliminar-cuenta": "node scripts/build-account-deletion-page.mjs",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "packageManager": "pnpm@11.21.0",
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "only-allow": "^1.2.2",
    "typescript": "5.9.3"
  }
}
